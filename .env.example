# ─────────────────────────────────────────────────────────────
#  North Pole Post — settings
#  1. Copy this file and rename the copy to  .env
#  2. Fill in your real values below
#  3. Save, then run:  npm start
#  NEVER share your .env file or put the SECRET key on a website.
# ─────────────────────────────────────────────────────────────

# --- Razorpay (get these from https://dashboard.razorpay.com → Settings → API Keys) ---
# Start with TEST keys (they begin with rzp_test_). Switch to LIVE keys (rzp_live_) after KYC.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Price in paise. 100 = ₹1 (for testing). Change to 9900 for ₹99 later. ---
PRICE_PAISE=100

# --- Email delivery (optional but recommended) ---
# Easiest: a Gmail account with an "App Password" (see README).
# Leave these blank to skip email — letters still appear on screen after payment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_16_letter_app_password
MAIL_FROM=North Pole Post <youremail@gmail.com>

# --- Server port (leave as is unless you have a reason to change it) ---
PORT=3000
