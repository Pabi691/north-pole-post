# ─────────────────────────────────────────────────────────────
#  Letter Shop — settings
#  1. Copy this file and rename the copy to  .env
#  2. Fill in your real values below
#  3. Save, then run:  npm start
#  NEVER share your .env file or put the SECRET key on a website.
# ─────────────────────────────────────────────────────────────

# --- Razorpay (get these from https://dashboard.razorpay.com → Settings → API Keys) ---
# Start with TEST keys (they begin with rzp_test_). Switch to LIVE keys (rzp_live_) after KYC.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin dashboard password (for /admin.html). Use something strong. ---
ADMIN_PASSWORD=change-this-password

# --- Upstash Redis (free) — for visitor stats + season settings that SURVIVE restarts.
#     Create a free DB at https://upstash.com → copy the REST URL + token here.
#     Leave both blank to use a local file (fine on your PC; resets on Render's free plan).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (The price is now set per-season in the admin dashboard, not here.)

# --- Email delivery ---
# RECOMMENDED on cloud hosts (Render blocks SMTP ports): Brevo HTTP API — sends over HTTPS.
#   Free at https://brevo.com → verify your sender email → SMTP & API → API Keys → paste below.
BREVO_API_KEY=

# --- SMTP fallback (works locally; usually BLOCKED on Render/other cloud hosts) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_16_letter_app_password
MAIL_FROM=North Pole Post <youremail@gmail.com>

# --- Server port (leave as is unless you have a reason to change it) ---
PORT=3000
